# ══════════════════════════════════════════════════════════════════════════
# Local development environment
#
# Copy to `.env` for local work. This file describes the DEVELOPMENT profile.
#
# The production VPS profile is a different, smaller contract — see
# `deploy/.env.production.example` and `deploy/README.md`. Do not copy values
# between the two files.
# ══════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ───────────────────────────────────────────────────────────
# Local Docker development (see docker-compose.yml):
DATABASE_URI=postgresql://payload:payload@localhost:5432/aau_platform
DATABASE_DIRECT_URI=postgresql://payload:payload@localhost:5432/aau_platform
#
# Payload transactions and migrations require a DIRECT (non-pooled)
# connection. If you use a managed provider with a connection pooler, point
# DATABASE_DIRECT_URI at its direct endpoint.

# ─── Payload secret ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
# Startup fails until this placeholder is replaced.
PAYLOAD_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_32_CHARS

# Local development only. The Payload config throws if this is true while
# NODE_ENV=production — production always uses committed migrations.
PAYLOAD_DB_PUSH=false

# ─── Server URL ───────────────────────────────────────────────────────────
# NOTE: NEXT_PUBLIC_* values are inlined by `next build`. In a built image this
# is a BUILD argument, not a runtime variable — setting it in the production
# environment has no effect. See deploy/README.md.
#
# In the production runtime this must be a real public HTTPS origin; the app
# fails closed on a missing, loopback or non-HTTPS value and never falls back
# to localhost.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
DEFAULT_LOCALE=ar
SUPPORTED_LOCALES=ar,en

# ─── Runtime startup behaviour (production containers) ────────────────────
# Both default to OFF and are ignored during `next build`. The VPS compose
# file turns them on; local development normally leaves them off.
#
# Apply pending Payload migrations at container start (`prodMigrations`).
PAYLOAD_RUNTIME_MIGRATIONS=false
# Ensure canonical system Roles + the configured Super Admin exist.
# This is the MINIMAL identity bootstrap — NOT the broad content Seed.
PAYLOAD_RUNTIME_BOOTSTRAP=false

# ─── Initial Super Admin ──────────────────────────────────────────────────
# Stable bootstrap identity. The password is required only when the account
# does not exist yet; an existing account is validated, never rewritten, and
# its password is never reset.
# Must be >= 12 characters with lowercase, uppercase, digit and special char.
INITIAL_ADMIN_EMAIL=admin@example.edu
INITIAL_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ─── Broad content Seed (development / CI only) ───────────────────────────
# The broad canonical Seed is NEVER part of a production start, deploy,
# restart or reboot. It stays disabled here and in the VPS profile.
PAYLOAD_SEED_ENABLED=false
# The settings below only matter for the optional /next/seed route while it is
# enabled in development. They are deliberately NOT part of the VPS runtime
# profile. Must be exactly 64 hexadecimal characters; this placeholder is
# intentionally invalid so the endpoint fails closed.
PAYLOAD_SEED_SECRET=INVALID_REPLACE_WITH_64_HEX_CHARACTERS
# Server-only exact origin trusted by the seed endpoint.
PAYLOAD_SERVER_ORIGIN=http://localhost:3000

# ─── Uploads ──────────────────────────────────────────────────────────────
# Local persistent filesystem storage is the selected mode for the VPS.
# Leave unset locally to default to `<cwd>/uploads`.
# PAYLOAD_UPLOADS_DIR=/app/uploads

# ─── Public form rate limits ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX_REQUESTS=5

# ─── Test-only escape hatch ───────────────────────────────────────────────
# Allows a loopback/HTTP origin while NODE_ENV=production. Used ONLY by the
# standalone browser suite, which serves the production artifact over local
# HTTP. Setting this on the VPS would disable the HTTPS-origin guard.
# PAYLOAD_ALLOW_INSECURE_ORIGIN=true

# ══════════════════════════════════════════════════════════════════════════
# OPTIONAL — external S3/R2 object storage
#
# The production VPS uses local persistent uploads (S3_ENABLED=false). The S3
# adapter stays in the codebase as an optional future backend. Do NOT add
# MinIO/Garage to the single-VPS architecture without a real storage
# requirement.
# ══════════════════════════════════════════════════════════════════════════
S3_ENABLED=false
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=media
S3_PRIVATE_PREFIX=private-media
# Public serving domain for R2 buckets (e.g. https://pub-xxxx.r2.dev). When
# set, public media URLs are generated from this domain and it is allow-listed
# in the CSP and next/image remotePatterns. Leave empty for local storage.
R2_PUBLIC_URL=

# ─── Smart Chat ───────────────────────────────────────────────────────────
# Environment only; never persist provider keys in Payload globals.
SMART_CHAT_API_KEY=

# ─── CMS ecosystem plugins ────────────────────────────────────────────────
# Keep API docs disabled unless intentionally exposed behind admin/VPN control.
OPENAPI_ENABLED=false
OPENAPI_DOCS_ENABLED=false

# AI features are opt-in and use environment secrets only.
PAYLOAD_AI_ENABLED=false
AI_LOCALIZATION_ENABLED=false
AI_LOCALIZATION_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ELEVENLABS_API_KEY=
MINIMAX_API_KEY=
