# Copy to .env.docker for local Docker development. Keep real values out of git.
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
INITIAL_ADMIN_EMAIL=admin@example.edu
INITIAL_ADMIN_PASSWORD=replace-with-a-local-password

# Optional Cloudflare R2/S3-compatible media storage.
S3_ENABLED=false
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=media
S3_PRIVATE_PREFIX=private-media
R2_PUBLIC_URL=
