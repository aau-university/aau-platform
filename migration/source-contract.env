# THE FROZEN NEON SOURCE CONTRACT — captured 2026-09-07.
#
# The Neon `production` data is FROZEN: no content is being added before the
# VPS cutover. Every number below was measured against that frozen source (and
# against the Golden PostgreSQL 18 schema built from the final repo migrations
# at 474728e9045e3a0bdee1e3601d0ba4b7a49b7b1e) during the validated simulation
# recorded in migration/simulation/README.md.
#
# Because the source is frozen, this file is a CONTRACT, not a snapshot to be
# refreshed. The migration tooling fails closed when the live source no longer
# matches it: a difference means either the freeze was broken or the tooling is
# pointed at the wrong database, and both are reasons to stop rather than to
# regenerate these values. There is deliberately no CDC, incremental sync or
# dynamic snapshot machinery here — a frozen source needs none, and building it
# would add a moving part that nothing verifies.
#
# Values are plain, unquoted and non-secret. Read with migration/scripts/lib/contract.sh.

NEON_SOURCE_FREEZE_DATE=2026-09-07
NEON_SOURCE_REFERENCE_COMMIT=474728e9045e3a0bdee1e3601d0ba4b7a49b7b1e

# ── Source invariants the upgrade script's safety assertions depend on ────
# 01_upgrade_working_copy.sql RAISEs on each of these; asserting them BEFORE
# the dump is produced (and again after it is restored) turns a mid-migration
# abort into a preflight refusal.
SOURCE_PAYLOAD_MIGRATIONS_ROWS=0
SOURCE_PAYLOAD_JOBS_ROWS=0
SOURCE_PAYLOAD_JOBS_LOG_ROWS=0
SOURCE_DUPLICATE_STUDY_PLAN_GROUPS=0
SOURCE_NULL_PUBLICATION_FLAGS=0
SOURCE_OFFER_STATUS_MISMATCHES=0
SOURCE_OFFER_VERSION_STATUS_MISMATCHES=0

# ── Public Media (IN SCOPE: rows AND binaries) ────────────────────────────
SOURCE_MEDIA_ROWS=123
SOURCE_PUBLIC_MEDIA_HOST=pub-8a0efee290014de68b7c23df759d720c.r2.dev
# Every public media row must point at that one R2 origin. A row that does not
# would silently survive the URL rewrite as an external reference.
SOURCE_MEDIA_FOREIGN_URL_ROWS=0
PUBLIC_MEDIA_OBJECTS=619
PUBLIC_MEDIA_ORIGINALS=123
PUBLIC_MEDIA_BYTES=62447631

# ── Private Media (rows IN SCOPE, binaries DELIBERATELY OUT OF SCOPE) ─────
# The row count is not a frozen constant here: it is captured from the restored
# source and asserted UNCHANGED after the upgrade, which is the property that
# matters. No private binary is ever fetched.
PRIVATE_MEDIA_BINARIES_MIGRATED=false

# ── Target invariants (the Golden PostgreSQL 18 schema) ──────────────────
TARGET_TABLES=346
TARGET_COLUMNS=2584
TARGET_ENUM_TYPES=113
TARGET_CONSTRAINTS=1981
TARGET_INDEXES=1285
TARGET_SEQUENCES=280
TARGET_MIGRATION_LEDGER=20260809_020424_baseline:1,20260815_025241_one_study_plan_per_program:1
TARGET_INVALID_PUBLIC_URLS=0
TARGET_INVALID_PUBLIC_THUMBNAILS=0
TARGET_LOCAL_MEDIA_PREFIX=/api/media/file/
