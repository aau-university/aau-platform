{
  "name": "aau-payload-platform",
  "version": "0.1.0",
  "description": "AAU University Platform \u2014 Payload CMS + Next.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "build:standalone": "cross-env NEXT_OUTPUT_STANDALONE=true pnpm build && node scripts/prepare-standalone.mjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbo",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev --turbo",
    "generate:db-schema": "cross-env NODE_OPTIONS=--no-deprecation payload generate:db-schema",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "check:payload-versions": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/check-payload-versions.ts",
    "audit:dependencies": "node scripts/check-dependency-audit.mjs",
    "verify:generated": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/verify-generated.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "cross-env NODE_OPTIONS=--no-deprecation next typegen && tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "schema:push": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/push-schema.ts",
    "db:reset:local": "cross-env APP_ENV=local-docker RESET_LOCAL_DB=true NODE_OPTIONS=--no-deprecation tsx scripts/clean-dev-data.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "start:standalone": "cross-env NODE_OPTIONS=--no-deprecation node .next/standalone/server.js",
    "test": "pnpm run test:unit && pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env PAYLOAD_DB_PUSH=false S3_ENABLED=false PAYLOAD_SERVER_ORIGIN=http://localhost:3000 NEXT_PUBLIC_SERVER_URL=http://localhost:3000 pnpm build:standalone && cross-env PAYLOAD_DB_PUSH=false S3_ENABLED=false PAYLOAD_SERVER_ORIGIN=http://localhost:3000 NEXT_PUBLIC_SERVER_URL=http://localhost:3000 NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.db.config.mts",
    "test:db": "pnpm run test:int"
  },
  "dependencies": {
    "@ai-stack/payloadcms": "4.0.1",
    "@aws-sdk/client-s3": "3.1069.0",
    "@hookform/resolvers": "^5.4.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/live-preview": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-form-builder": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-aspect-ratio": "^1.1.10",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-radio-group": "^1.4.1",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.7",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.40.0",
    "jose": "5.10.0",
    "lucide-react": "^0.460.0",
    "next": "16.4.4",
    "next-safe-action": "^8.5.4",
    "nuqs": "^2.8.9",
    "payload": "3.90.2",
    "payload-blurhash-plugin": "3.1.0",
    "payload-oapi": "0.2.5",
    "payload-plugin-ai-localization": "1.0.3",
    "react": "19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.7",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.80.0",
    "redis": "^6.0.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "16.4.4",
    "@playwright/test": "^1.50.0",
    "@testcontainers/postgresql": "12.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.5.0",
    "esbuild": "0.28.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.4.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.15",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "testcontainers": "12.1.0",
    "tsx": "^4.22.0",
    "typescript": "^5.8.0",
    "vite-tsconfig-paths": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": "^9 || ^10"
  },
  "packageManager": "pnpm@10.34.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "sharp": "0.35.5",
      "browserslist": "^4.28.9",
      "fast-uri": "^3.1.7",
      "js-yaml@^4": "^4.3.2",
      "undici@^7": "^7.30.1",
      "brace-expansion@^5": "^5.0.12",
      "dompurify@^3": "^3.4.17",
      "form-data@^4": "^4.0.6",
      "immutable@^4": "^4.3.9",
      "source-map-js@^1": "^1.2.2",
      "happy-dom@^20": "^21.0.4",
      "payload-blurhash-plugin>zod": "^4.6.7",
      "payload-plugin-ai-localization>zod": "^4.6.7"
    }
  }
}
